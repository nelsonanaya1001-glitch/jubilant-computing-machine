DATABASE_URL="postgresql://user:password@localhost:5432/launchboarding_db"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
UPLOAD_DIR="./public/uploads"

# Public site origin — used for Stripe success/cancel return URLs.
NEXT_PUBLIC_SITE_URL="https://launchboarding.com"

# Payments. Without these the cart still records orders and emails you,
# but no card is charged — see src/lib/stripe.ts.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Admin email alerts (optional) — see src/lib/notify.ts.
RESEND_API_KEY=""
ADMIN_EMAIL=""
