generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  SUBMITTED
  DISCOVERY
  DESIGN
  DEVELOPMENT
  REVIEW
  COMPLETED
}

enum BrandStatus {
  SUBMITTED
  GENERATED
  IN_REVIEW
  DELIVERED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  sentMessages  Message[] @relation("SentMessages")
  adminNotes    AdminNote[]
  brandSubmissions BrandSubmission[]

  @@map("users")
}

model Project {
  id            String        @id @default(cuid())
  clientId      String
  title         String
  status        ProjectStatus @default(SUBMITTED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submission    FormSubmission?
  files         UploadedFile[]
  statusUpdates ProjectStatusUpdate[]
  messages      Message[]
  adminNotes    AdminNote[]

  @@map("projects")
}

model FormSubmission {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  businessName        String
  industry            String
  contactName         String
  email               String
  phone               String
  website             String?
  servicesOffered     String
  serviceArea         String
  targetAudience      String
  businessDescription String
  preferredColors     String
  preferredStyle      String
  competitorWebsites  String?
  websitesTheyLike    String?
  featuresNeeded      Json
  hasLogo             String?
  logoText            String?
  logoStyle           String?
  logoColorNotes      String?
  logoIdeas           String?
  logoInspiration     String?
  createdAt           DateTime @default(now())

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("form_submissions")
}

model UploadedFile {
  id           String   @id @default(cuid())
  projectId    String
  fileName     String
  originalName String
  fileType     String
  fileSize     Int
  filePath     String
  category     String   @default("other")
  uploadedAt   DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("uploaded_files")
}

model ProjectStatusUpdate {
  id        String        @id @default(cuid())
  projectId String
  oldStatus ProjectStatus
  newStatus ProjectStatus
  note      String?
  createdAt DateTime      @default(now())

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_status_updates")
}

model Message {
  id             String    @id @default(cuid())
  projectId      String
  senderId       String
  content        String
  isAdminMessage Boolean   @default(false)
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender         User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

/// A Brand & Identity Package order. Intentionally standalone (its own category),
/// not nested under Project — a client can buy branding with or without a website.
model BrandSubmission {
  id                  String      @id @default(cuid())
  clientId            String?
  /// Optional link when branding is bought alongside a website order.
  projectId           String?

  businessName        String
  tagline             String?
  industry            String
  contactName         String
  email               String
  phone               String?

  targetAudience      String
  businessDescription String

  /// e.g. ["modern","bold"] — chosen style directions
  stylePreferences    Json
  /// e.g. ["#7c3aed","#f43f5e"] — client-picked seed colors
  seedColors          Json
  colorNotes          String?
  avoidColors         String?

  /// wordmark | monogram | icon-wordmark | no-preference
  logoTypePref        String?
  inspirationRefs     String?
  competitorNotes     String?

  tier                String      @default("standard")
  status              BrandStatus @default(SUBMITTED)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  client              User?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assets              BrandAsset[]

  @@map("brand_submissions")
}

/// A generated asset belonging to a BrandSubmission: a logo concept (SVG),
/// the colour palette, or the font pairing.
model BrandAsset {
  id                String   @id @default(cuid())
  brandSubmissionId String
  /// "logo" | "palette" | "fonts"
  kind              String
  label             String?
  /// Inline SVG markup for logo concepts.
  svg               String?
  /// Structured data for palettes/fonts.
  data              Json?
  /// Marks the concept the client picked.
  selected          Boolean  @default(false)
  createdAt         DateTime @default(now())

  submission        BrandSubmission @relation(fields: [brandSubmissionId], references: [id], onDelete: Cascade)

  @@index([brandSubmissionId])
  @@map("brand_assets")
}

model AdminNote {
  id        String   @id @default(cuid())
  projectId String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("admin_notes")
}
