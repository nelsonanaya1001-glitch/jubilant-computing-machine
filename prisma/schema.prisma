generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  SUBMITTED
  DISCOVERY
  DESIGN
  DEVELOPMENT
  REVIEW
  COMPLETED
}

enum OrderStatus {
  PENDING
  /// Awaiting a delayed-notification payment (e.g. a bank debit) to settle.
  PROCESSING
  PAID
  /// A recurring invoice failed — Stripe is retrying (dunning).
  PAST_DUE
  FAILED
  CANCELLED
  REFUNDED
  DISPUTED
  /// Sent as a Stripe Invoice; waiting for the client to pay it.
  INVOICED
}

enum BrandStatus {
  SUBMITTED
  GENERATED
  IN_REVIEW
  DELIVERED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects         Project[]
  sentMessages     Message[]         @relation("SentMessages")
  adminNotes       AdminNote[]
  brandSubmissions BrandSubmission[]
  orders           Order[]

  /// Reused so a client never ends up with duplicate Stripe Customers.
  stripeCustomerId String? @unique

  @@map("users")
}

model Project {
  id        String        @id @default(cuid())
  clientId  String
  title     String
  status    ProjectStatus @default(SUBMITTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client        User                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submission    FormSubmission?
  files         UploadedFile[]
  statusUpdates ProjectStatusUpdate[]
  messages      Message[]
  adminNotes    AdminNote[]

  @@map("projects")
}

model FormSubmission {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  businessName        String
  industry            String
  contactName         String
  email               String
  phone               String
  website             String?
  servicesOffered     String
  serviceArea         String
  targetAudience      String
  businessDescription String
  preferredColors     String
  preferredStyle      String
  competitorWebsites  String?
  websitesTheyLike    String?
  featuresNeeded      Json
  hasLogo             String?
  logoText            String?
  logoStyle           String?
  logoColorNotes      String?
  logoIdeas           String?
  logoInspiration     String?
  /// Which services the client selected at the start of the intake.
  wantsWebsite        Boolean  @default(true)
  wantsBranding       Boolean  @default(false)
  wantsAds            Boolean  @default(false)
  /// Only collected when Meta Ads is selected.
  adsMonthlyBudget    String?
  adsGoal             String?
  createdAt           DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("form_submissions")
}

model UploadedFile {
  id           String   @id @default(cuid())
  projectId    String
  fileName     String
  originalName String
  fileType     String
  fileSize     Int
  filePath     String
  category     String   @default("other")
  uploadedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("uploaded_files")
}

model ProjectStatusUpdate {
  id        String        @id @default(cuid())
  projectId String
  oldStatus ProjectStatus
  newStatus ProjectStatus
  note      String?
  createdAt DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_status_updates")
}

model Message {
  id             String    @id @default(cuid())
  projectId      String
  senderId       String
  content        String
  isAdminMessage Boolean   @default(false)
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

/// A Brand & Identity Package order. Intentionally standalone (its own category),
/// not nested under Project — a client can buy branding with or without a website.
model BrandSubmission {
  id        String  @id @default(cuid())
  clientId  String?
  /// Optional link when branding is bought alongside a website order.
  projectId String?

  businessName String
  tagline      String?
  industry     String
  contactName  String
  email        String
  phone        String?

  targetAudience      String
  businessDescription String

  /// e.g. ["modern","bold"] — chosen style directions
  stylePreferences Json
  /// e.g. ["#7c3aed","#f43f5e"] — client-picked seed colors
  seedColors       Json
  colorNotes       String?
  avoidColors      String?

  /// wordmark | monogram | icon-wordmark | no-preference
  logoTypePref    String?
  inspirationRefs String?
  competitorNotes String?

  tier      String      @default("standard")
  status    BrandStatus @default(SUBMITTED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  client User?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assets BrandAsset[]

  @@map("brand_submissions")
}

/// A generated asset belonging to a BrandSubmission: a logo concept (SVG),
/// the colour palette, or the font pairing.
model BrandAsset {
  id                String   @id @default(cuid())
  brandSubmissionId String
  /// "logo" | "palette" | "fonts"
  kind              String
  label             String?
  /// Inline SVG markup for logo concepts.
  svg               String?
  /// Structured data for palettes/fonts.
  data              Json?
  /// Marks the concept the client picked.
  selected          Boolean  @default(false)
  createdAt         DateTime @default(now())

  submission BrandSubmission @relation(fields: [brandSubmissionId], references: [id], onDelete: Cascade)

  @@index([brandSubmissionId])
  @@map("brand_assets")
}

model AdminNote {
  id        String   @id @default(cuid())
  projectId String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("admin_notes")
}

/// A client's purchase, created the moment they hit checkout and updated by the
/// Stripe webhook once payment succeeds. Amounts are always recomputed from
/// src/lib/catalog.ts on the server — never taken from the browser.
model Order {
  id        String @id @default(cuid())
  /// Short human-friendly code we quote in emails, e.g. "LB-4F9K2A".
  reference String @unique

  email   String
  name    String?
  company String?
  phone   String?
  notes   String?

  /// The purchased catalogue items as they were priced at checkout:
  /// [{ sku, name, setupCents, monthlyCents }]
  items Json

  /// "deposit" (half the one-time fee now) or "full".
  paymentChoice String
  /// One-time total before the bundle discount.
  subtotalCents Int
  discountCents Int
  /// Charged today.
  dueTodayCents Int
  /// Remaining one-time balance, due on delivery.
  balanceCents  Int
  /// Recurring monthly total, if any.
  monthlyCents  Int
  currency      String @default("usd")

  status                OrderStatus @default(PENDING)
  stripeSessionId       String?     @unique
  stripeCustomerId      String?
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  /// Set when the client chose "invoice me" instead of paying by card.
  stripeInvoiceId       String?
  /// Stripe's own subscription status (active, past_due, canceled, …).
  subscriptionStatus    String?
  paidAt                DateTime?
  /// Most recent recurring invoice we saw settle.
  lastInvoicePaidAt     DateTime?
  /// Total refunded so far, in cents.
  refundedCents         Int         @default(0)
  disputedAt            DateTime?
  /// Set when Radar flags the charge as likely fraudulent.
  fraudWarningAt        DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@map("orders")
}
